amples\": [\n          9.51\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"lpips\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.061403610100167025,\n        \"min\": 0.0172,\n        \"max\": 0.1497,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          0.1497\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
